; AUTHOR: Dimitri Vinci
; BRIEF DESCRIPTION:
; Domain for ex1 of APTP exam project
; PLANNING VERSION: Classical planning, PDDL 1.0
; REQUIRE: strips + typing + equality - negative precondition

(define 

    (domain ex3_P_NR_P)
    
    (:requirements :typing :hierachie)
    
    (:types 
        person box robot content - object  
        ; to handle not returning to depot
        generic_location - object
        location - generic_location
        depot - generic_location
        medicine tool food - content ;; subclassed content
        carrier - object ;; carrier of robot 
    )


    (:predicates
        ; position
        (be_at_person ?l - generic_location ?p - person ) ;; true if person is in a given location
        (be_at_box ?b - box ?l - generic_location) ;; true if box is in a given location
        (be_at_content ?c - content ?l - generic_location)  ;; true if content is in a given location
        (be_at_robot ?l - generic_location ?r - robot )  ;; true if content is in a given location
        (is_assigned_box ?b - box) 
        (not_is_assigned_box ?b - box) 
        ; handle relation between object
        ; box
        (empty_box ?b - box)  ;; true if box not partecipate in any assigned_box_content predicate 
        (assigned_box_content ?b - box ?c - content) ;; true if a box contain a content
        (not_assigned_box_content ?b - box ?c - content) ;; negated version of previous predicate 
        ; person
        (assigned_person_content ?c - content ?p - person ) ;; true if a person has assigned a content
        (not_assigned_person_content ?c - content ?p - person ) ;; negated version of previous predicate 
        ; robot
        (assigned_robot_carrier ?c - carrier ?r - robot )  ;; true if robot is carrying an object
        (not_assigned_robot_carrier ?c - carrier ?r - robot )  ;; negated version of previos predicate
        ; content
        (is_assigned ?c - content) ;; true if a content partecipate in at least one assigned assigned_box_content predicate
        (not_is_assigned ?c - content) ;; negated versione of previous predicate 
        ; carrier
        (assigned_carrier_box ?b - box ?c - carrier )
        (not_assigned_carrier_box  ?b - box ?c - carrier)
        ; to handle carrier capacity
        (carrier_capacity_0 ?c - carrier)
        (carrier_capacity_1 ?c - carrier)
        (carrier_capacity_2 ?c - carrier)
        (carrier_capacity_3 ?c - carrier)
        (carrier_capacity_4 ?c - carrier)
    )
    
    
    ; TASK SECTION
    
    (:task deliver_food_tool_medicine
 	:parameters (?p1 ?p2 ?p3 - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    
    (:task deliver_food_tool
 	:parameters (?p1 ?p2  - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    
    (:task deliver_food_medicine
 	:parameters (?p1 ?p2  - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    
    (:task deliver_tool_medicine
 	:parameters (?p1 ?p2  - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    
    (:task deliver_food
 	:parameters (?p - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    (:task deliver_medicine
 	:parameters (?p - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    (:task deliver_tool
 	:parameters (?p - person ?r - robot) 
 	:precondition () 
  	:effect () 
    ) 
    
    ; component of deliver
    ; get to location (generic, could also be depot)
    (:task get_to 
    	:parameters (?l - generic_location ?r - robot ) 
    	:precondition () 
 	:effect () 
    ) 
    ; load smth to carrier
    (:task load 
  	:parameters (?b - box ?l - generic_location ?r - robot)  
  	:precondition () 
  	:effect () 
    )
    ; fill a box
    (:task fill 
    	:parameters (?b - box ?c - content ?r - robot ) 
    	:precondition () 
 	:effect () 
    ) 
    ; unload smth to position (here location because only location could contain a person)
    (:task unload 
  	:parameters (?b - box  ?l - generic_location ?r - robot) 
  	:precondition () 
  	:effect () 
    ) 
    ; empty a box assigning smth to sm
    (:task assign_box 
  	:parameters (?b - box  ?c - content ?l - generic_location ?p - person ?r - robot) 
  	:precondition () 
  	:effect () 
    ) 

    
    ; METHOD SECTION
    
    ; METHOD SECTION - to handle deliver
    ; in this variant is make no assumption about reciprocal position of boxes and contents
 
    ; handle deliver of food tool medicine
    (:method m_deliver_food_tool_medicine
  	:parameters (?b1 ?b2 ?b3 - box ?c1 - food ?c2 - tool ?c3 - medicine ?lb1 ?lc1 ?lp1 ?lb2 ?lc2 ?lp2 ?lb3 ?lc3 ?lp3 - generic_location ?p1 ?p2 ?p3 - person ?r - robot) 
  	:task (deliver_food_tool_medicine ?p1 ?p2 ?p3 ?r) 
  	:precondition (and  	  	   
  	    ; box have not be the same (in this case content have different tipe so surely not the same)
  	    (not
  	    	(= ?b1 ?b2)
  	    )
  	    (not
  	    	(= ?b1 ?b3)
  	    )
  	    (not
  	    	(= ?b2 ?b3)
  	    )
  	    ; position of box
  	    (be_at_box ?b1 ?lb1 )
  	    (be_at_box ?b2 ?lb2 )
  	    (be_at_box ?b3 ?lb3 )
  	    ; position of person
  	    (be_at_person ?lp1 ?p1)  
  	    (be_at_person ?lp2 ?p2)
  	    (be_at_person ?lp3 ?p3)
  	    ; position of content
  	    (be_at_content  ?c1 ?lc1)
  	    (be_at_content  ?c2 ?lc2 )
  	    (be_at_content  ?c3 ?lc3)
  	) 
	:subtasks (and 
	    ; first assignment
            ; go to location if not already reached and load box
            (task00 (get_to ?lb1 ?r)) 
            (task01 (load ?b1 ?lb1 ?r))
            ; go to content location and load content
            (task02 (get_to ?lc1 ?r)) 
            (task03 (unload ?b1 ?lc1 ?r)) ; first unload box
            (task04 (fill ?b1 ?c1 ?r)) ; fill the box
            (task05 (load ?b1  ?lc1 ?r)) ; load the box
            ; reach objective
	    (task06 (get_to ?lp1 ?r)) 
	    (task07 (unload ?b1 ?lp1 ?r))
	    (task08 (assign_box ?b1 ?c1 ?lp1 ?p1 ?r)) 
	    ; second assignment
            ; go to location if not already reached and load box
            (task10 (get_to ?lb2 ?r)) 
            (task11 (load ?b2  ?lb2 ?r))
            ; go to content location and load content
            (task12 (get_to ?lc2 ?r)) 
            (task13 (unload ?b2 ?lc2 ?r)) ; first unload box
            (task14 (fill ?b2 ?c2 ?r)) ; fill the box
            (task15 (load ?b2  ?lc2 ?r)) ; load the box
            ; reach objective
	    (task16 (get_to ?lp2 ?r)) 
	    (task17 (unload ?b2 ?lp2 ?r))
	    (task18 (assign_box ?b2 ?c2 ?lp2 ?p2 ?r)) 
	    ; third assignment
            ; go to location if not already reached and load box
            (task20 (get_to ?lb3 ?r)) 
            (task21 (load ?b3  ?lb3 ?r))
            ; go to content location and load content
            (task22 (get_to ?lc3 ?r)) 
            (task23 (unload ?b3 ?lc3 ?r)) ; first unload box
            (task24 (fill ?b3 ?c3 ?r)) ; fill the box
            (task25 (load ?b3  ?lc3 ?r)) ; load the box
            ; reach objective
	    (task26 (get_to ?lp3 ?r)) 
	    (task27 (unload ?b3 ?lp3 ?r))
	    (task28 (assign_box ?b3 ?c3 ?lp3 ?p3 ?r)) 
	)    
        :ordering (and 
            ; order first assignment
            (task00 < task01) 
	    (task01 < task02) 
	    (task02 < task03) 
	    (task03 < task04) 
	    (task04 < task05) 
	    (task05 < task06) 
	    (task06 < task07) 
	    (task07 < task08)
	    ; order second assignment
            (task10 < task11) 
	    (task11 < task12) 
	    (task12 < task13) 
	    (task13 < task14) 
	    (task14 < task15) 
	    (task15 < task16) 
	    (task16 < task17) 
	    (task17 < task18)   
	    ; order third assignment
            (task20 < task21) 
	    (task21 < task22) 
	    (task22 < task23) 
	    (task23 < task24) 
	    (task24 < task25) 
	    (task25 < task26) 
	    (task26 < task27) 
	    (task27 < task28)        
       ) 
    )
    
    ; handle deliver of food tool medicine
    (:method m_deliver_food_tool
  	:parameters (?b1 ?b2  - box ?c1 - food ?c2 - tool  ?lb1 ?lc1 ?lp1 ?lb2 ?lc2 ?lp2  - generic_location ?p1 ?p2  - person ?r - robot) 
  	:task (deliver_food_tool ?p1 ?p2  ?r) 
  	:precondition (and  	  	   
  	    ; box have not be the same (in this case content have different tipe so surely not the same)
  	    (not
  	    	(= ?b1 ?b2)
  	    )  	  
  	    ; position of box
  	    (be_at_box ?b1 ?lb1 )
  	    (be_at_box ?b2 ?lb2 )
  	    ; position of person
  	    (be_at_person ?lp1 ?p1)  
  	    (be_at_person ?lp2 ?p2)
  	    ; position of content
  	    (be_at_content  ?c1 ?lc1)
  	    (be_at_content  ?c2 ?lc2 )
  	) 
	:subtasks (and 
	    ; first assignment
            ; go to location if not already reached and load box
            (task00 (get_to ?lb1 ?r)) 
            (task01 (load ?b1 ?lb1 ?r))
            ; go to content location and load content
            (task02 (get_to ?lc1 ?r)) 
            (task03 (unload ?b1 ?lc1 ?r)) ; first unload box
            (task04 (fill ?b1 ?c1 ?r)) ; fill the box
            (task05 (load ?b1  ?lc1 ?r)) ; load the box
            ; reach objective
	    (task06 (get_to ?lp1 ?r)) 
	    (task07 (unload ?b1 ?lp1 ?r))
	    (task08 (assign_box ?b1 ?c1 ?lp1 ?p1 ?r)) 
	    ; second assignment
            ; go to location if not already reached and load box
            (task10 (get_to ?lb2 ?r)) 
            (task11 (load ?b2  ?lb2 ?r))
            ; go to content location and load content
            (task12 (get_to ?lc2 ?r)) 
            (task13 (unload ?b2 ?lc2 ?r)) ; first unload box
            (task14 (fill ?b2 ?c2 ?r)) ; fill the box
            (task15 (load ?b2  ?lc2 ?r)) ; load the box
            ; reach objective
	    (task16 (get_to ?lp2 ?r)) 
	    (task17 (unload ?b2 ?lp2 ?r))
	    (task18 (assign_box ?b2 ?c2 ?lp2 ?p2 ?r)) 	    
	)    
        :ordering (and 
            ; order first assignment
            (task00 < task01) 
	    (task01 < task02) 
	    (task02 < task03) 
	    (task03 < task04) 
	    (task04 < task05) 
	    (task05 < task06) 
	    (task06 < task07) 
	    (task07 < task08)
	    ; order second assignment
            (task10 < task11) 
	    (task11 < task12) 
	    (task12 < task13) 
	    (task13 < task14) 
	    (task14 < task15) 
	    (task15 < task16) 
	    (task16 < task17) 
	    (task17 < task18)    
       ) 
    )
    (:method m_deliver_food_medicine
  	:parameters (?b1 ?b2  - box ?c1 - food ?c2 - medicine  ?lb1 ?lc1 ?lp1 ?lb2 ?lc2 ?lp2  - generic_location ?p1 ?p2  - person ?r - robot) 
  	:task (deliver_food_medicine ?p1 ?p2  ?r) 
  	:precondition (and  	  	   
  	    ; box have not be the same (in this case content have different tipe so surely not the same)
  	    (not
  	    	(= ?b1 ?b2)
  	    )  	  
  	    ; position of box
  	    (be_at_box ?b1 ?lb1 )
  	    (be_at_box ?b2 ?lb2 )
  	    ; position of person
  	    (be_at_person ?lp1 ?p1)  
  	    (be_at_person ?lp2 ?p2)
  	    ; position of content
  	    (be_at_content  ?c1 ?lc1)
  	    (be_at_content  ?c2 ?lc2 )
  	) 
	:subtasks (and 
	    ; first assignment
            ; go to location if not already reached and load box
            (task00 (get_to ?lb1 ?r)) 
            (task01 (load ?b1 ?lb1 ?r))
            ; go to content location and load content
            (task02 (get_to ?lc1 ?r)) 
            (task03 (unload ?b1 ?lc1 ?r)) ; first unload box
            (task04 (fill ?b1 ?c1 ?r)) ; fill the box
            (task05 (load ?b1  ?lc1 ?r)) ; load the box
            ; reach objective
	    (task06 (get_to ?lp1 ?r)) 
	    (task07 (unload ?b1 ?lp1 ?r))
	    (task08 (assign_box ?b1 ?c1 ?lp1 ?p1 ?r)) 
	    ; second assignment
            ; go to location if not already reached and load box
            (task10 (get_to ?lb2 ?r)) 
            (task11 (load ?b2  ?lb2 ?r))
            ; go to content location and load content
            (task12 (get_to ?lc2 ?r)) 
            (task13 (unload ?b2 ?lc2 ?r)) ; first unload box
            (task14 (fill ?b2 ?c2 ?r)) ; fill the box
            (task15 (load ?b2  ?lc2 ?r)) ; load the box
            ; reach objective
	    (task16 (get_to ?lp2 ?r)) 
	    (task17 (unload ?b2 ?lp2 ?r))
	    (task18 (assign_box ?b2 ?c2 ?lp2 ?p2 ?r)) 	    
	)    
        :ordering (and 
            ; order first assignment
            (task00 < task01) 
	    (task01 < task02) 
	    (task02 < task03) 
	    (task03 < task04) 
	    (task04 < task05) 
	    (task05 < task06) 
	    (task06 < task07) 
	    (task07 < task08)
	    ; order second assignment
            (task10 < task11) 
	    (task11 < task12) 
	    (task12 < task13) 
	    (task13 < task14) 
	    (task14 < task15) 
	    (task15 < task16) 
	    (task16 < task17) 
	    (task17 < task18)    
       ) 
    )
    (:method m_deliver_tool_medicine
  	:parameters (?b1 ?b2  - box ?c1 - tool ?c2 - medicine  ?lb1 ?lc1 ?lp1 ?lb2 ?lc2 ?lp2  - generic_location ?p1 ?p2  - person ?r - robot) 
  	:task (deliver_tool_medicine ?p1 ?p2  ?r) 
  	:precondition (and  	  	   
  	    ; box have not be the same (in this case content have different tipe so surely not the same)
  	    (not
  	    	(= ?b1 ?b2)
  	    )  	  
  	    ; position of box
  	    (be_at_box ?b1 ?lb1 )
  	    (be_at_box ?b2 ?lb2 )
  	    ; position of person
  	    (be_at_person ?lp1 ?p1)  
  	    (be_at_person ?lp2 ?p2)
  	    ; position of content
  	    (be_at_content  ?c1 ?lc1)
  	    (be_at_content  ?c2 ?lc2 )
  	) 
	:subtasks (and 
	    ; first assignment
            ; go to location if not already reached and load box
            (task00 (get_to ?lb1 ?r)) 
            (task01 (load ?b1 ?lb1 ?r))
            ; go to content location and load content
            (task02 (get_to ?lc1 ?r)) 
            (task03 (unload ?b1 ?lc1 ?r)) ; first unload box
            (task04 (fill ?b1 ?c1 ?r)) ; fill the box
            (task05 (load ?b1  ?lc1 ?r)) ; load the box
            ; reach objective
	    (task06 (get_to ?lp1 ?r)) 
	    (task07 (unload ?b1 ?lp1 ?r))
	    (task08 (assign_box ?b1 ?c1 ?lp1 ?p1 ?r)) 
	    ; second assignment
            ; go to location if not already reached and load box
            (task10 (get_to ?lb2 ?r)) 
            (task11 (load ?b2  ?lb2 ?r))
            ; go to content location and load content
            (task12 (get_to ?lc2 ?r)) 
            (task13 (unload ?b2 ?lc2 ?r)) ; first unload box
            (task14 (fill ?b2 ?c2 ?r)) ; fill the box
            (task15 (load ?b2  ?lc2 ?r)) ; load the box
            ; reach objective
	    (task16 (get_to ?lp2 ?r)) 
	    (task17 (unload ?b2 ?lp2 ?r))
	    (task18 (assign_box ?b2 ?c2 ?lp2 ?p2 ?r)) 	    
	)    
        :ordering (and 
            ; order first assignment
            (task00 < task01) 
	    (task01 < task02) 
	    (task02 < task03) 
	    (task03 < task04) 
	    (task04 < task05) 
	    (task05 < task06) 
	    (task06 < task07) 
	    (task07 < task08)
	    ; order second assignment
            (task10 < task11) 
	    (task11 < task12) 
	    (task12 < task13) 
	    (task13 < task14) 
	    (task14 < task15) 
	    (task15 < task16) 
	    (task16 < task17) 
	    (task17 < task18)    
       ) 
    )
    
    ; handle food deliver
    (:method m_deliver_food_basic
  	:parameters (?b - box ?c - food ?d ?l - generic_location ?p - person ?r - robot) 
  	:task (deliver_food ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l ?p)  ;; check if person in given location
  	    ; check if box and content are at depot
  	    (be_at_box ?b ?d )
  	    (be_at_content ?c ?d )
  	) 
	:subtasks (and 
            (task0 (get_to ?d ?r))            
            (task1 (fill ?b ?c ?r))
            (task2 (load ?b ?d ?r))
	    (task3 (get_to ?l ?r)) 
	    (task4 (unload ?b ?l ?r))
	    (task5 (assign_box ?b ?c ?l ?p ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
       ) 
    ) 
    
    ; handle medicine deliver
    (:method m_deliver_medicine_basic
  	:parameters (?b - box ?c - medicine ?d ?l - generic_location ?p - person ?r - robot) 
  	:task (deliver_medicine ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l ?p)  ;; check if person in given location
  	    ; check if box and content are at depot
  	    (be_at_box ?b ?d )
  	    (be_at_content ?c ?d )
  	) 
	:subtasks (and 
            (task0 (get_to ?d ?r)) 
            (task1 (fill ?b ?c ?r))
            (task2 (load ?b ?d ?r))
	    (task3 (get_to ?l ?r)) 
	    (task4 (unload ?b ?l ?r))
	    (task5 (assign_box ?b ?c ?l ?p ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
       ) 
    ) 
    
    ; handle tool deliver
    (:method m_deliver_tool_basic
  	:parameters (?b - box ?c - tool ?d ?l - generic_location ?p - person ?r - robot) 
  	:task (deliver_tool ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l ?p)  ;; check if person in given location
  	    ; check if box and content are at depot
  	    (be_at_box ?b ?d )
  	    (be_at_content ?c ?d )
  	) 
	:subtasks (and 
            (task0 (get_to ?d ?r)) 
            (task1 (fill ?b ?c ?r))
            (task2 (load ?b ?d ?r))
	    (task3 (get_to ?l ?r)) 
	    (task4 (unload ?b ?l ?r))
	    (task5 (assign_box ?b ?c ?l ?p ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
       ) 
    ) 
    
    ; to handle variant deliver situation in which box and content are not at same location 
    
    ; handle food deliver
    (:method m_deliver_food_var
  	:parameters (?b - box ?c - food ?l1 ?l2 ?l3 - generic_location ?p - person ?r - robot) 
  	:task (deliver_food ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l3 ?p)  ;; check if person in given location
  	    ; check if box and content are not same position
  	    (be_at_box ?l1 ?b)
  	    (be_at_content  ?c ?l2)
  	    (not
  	    	(= ?l2 ?l1)
  	    )
  	) 
	:subtasks (and 
	    ; go to location if not already reached and load box
            (task0 (get_to ?l1 ?r)) 
            (task1 (load ?b ?l1 ?r))
            ; go to content location and load content
            (task2 (get_to ?l2 ?r)) 
            (task3 (unload ?b ?l2 ?r)) ; first unload box
            (task4 (fill ?b ?c ?r)) ; fill the box
            (task5 (load ?b ?l2 ?r)) ; load the box
            ; reach objective
	    (task6 (get_to ?l3 ?r)) 
	    (task7 (unload ?b ?l3 ?r))
	    (task8 (assign_box ?b ?c ?l3 ?p ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
	    (task5 < task6) 
	    (task6 < task7) 
	    (task7 < task8)
       ) 
    ) 
    
    ; handle medicine deliver
    (:method m_deliver_medicine_var
  	:parameters (?b - box ?c - medicine ?l1 ?l2 ?l3 - generic_location ?p - person ?r - robot) 
  	:task (deliver_medicine ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l3 ?p)  ;; check if person in given location
  	    ; check if box and content are not same position
  	    (be_at_box  ?b ?l1)
  	    (be_at_content ?c ?l2 )
  	    (not
  	    	(= ?l2 ?l1)
  	    )
  	) 
	:subtasks (and 
	    ; go to location if not already reached and load box
            (task0 (get_to ?l1 ?r)) 
            (task1 (load ?b ?l1 ?r))
            ; go to content location and load content
            (task2 (get_to ?l2 ?r)) 
            (task3 (unload ?b ?l2 ?r)) ; first unload box
            (task4 (fill ?b ?c ?r)) ; fill the box
            (task5 (load ?b ?l2 ?r)) ; load the box
            ; reach objective
	    (task6 (get_to ?l3 ?r)) 
	    (task7 (unload ?b ?l3 ?r))
	    (task8 (assign_box ?b ?c ?l3 ?p  ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
	    (task5 < task6) 
	    (task6 < task7) 
	    (task7 < task8)
       ) 
    ) 
    
    ; handle tool deliver
    (:method m_deliver_tool_var
  	:parameters (?b - box ?c - tool ?l1 ?l2 ?l3 - generic_location ?p - person ?r - robot) 
  	:task (deliver_tool ?p ?r) 
  	:precondition (and
  	    (be_at_person ?l3 ?p)  ;; check if person in given location
  	    ; check if box and content are not same position
  	    (be_at_box ?b ?l1)
  	    (be_at_content ?c ?l2 )
  	    (not
  	    	(= ?l2 ?l1)
  	    )
  	) 
	:subtasks (and 
	    ; go to location if not already reached and load box
            (task0 (get_to ?l1 ?r)) 
            (task1 (load ?b ?l1 ?r))
            ; go to content location and load content
            (task2 (get_to ?l2 ?r)) 
            (task3 (unload ?b ?l2 ?r)) ; first unload box
            (task4 (fill ?b ?c ?r)) ; fill the box
            (task5 (load ?b ?l2 ?r)) ; load the box
            ; reach objective
	    (task6 (get_to ?l3 ?r)) 
	    (task7 (unload ?b ?l3 ?r))
	    (task8 (assign_box ?b ?c ?l3 ?p ?r)) 
	)    
        :ordering (and 
	    (task0 < task1) 
	    (task1 < task2) 
	    (task2 < task3) 
	    (task3 < task4) 
	    (task4 < task5) 
	    (task5 < task6) 
	    (task6 < task7) 
	    (task7 < task8)
       ) 
    )  

    
    ;  METHOD SECTION - handling movement
    
    ; if already there do not move (useful to handle already in depot
    (:method m_already_there 
 	:parameters (?l1 - generic_location ?l2 - generic_location ?r - robot) 
 	:task (get_to ?l2 ?r) 
 	:precondition (and
	      (= ?l1 ?l2)
	 ) 
 	:subtasks (and (task0 (noop ?r))) 
    ) 
    
    (:method m_get_to_move_cc_4
 	:parameters (?cr - carrier ?l1 ?l2 - generic_location ?r - robot) 
 	:task (get_to ?l2 ?r) 
 	:precondition (and
	     ; check if not same locations
	     (not 
		 (= ?l1 ?l2)
	     )
	     ; robot must be located at start 
             (be_at_robot ?l1 ?r)
             ; robot must be empty
             (carrier_capacity_4 ?cr)
	 ) 
 	:subtasks (and (task0 ( move_cc_4 ?cr ?l1 ?l2 ?r))) 
    ) 
    
    (:method m_get_to_move_cc_3_wc
 	:parameters (?b - box ?c - content ?cr - carrier ?l1 - generic_location ?l2 - location ?r - robot) 
 	:task (get_to ?l2 ?r) 
 	:precondition (and
	     ; check if not same locations
	     (not 
		  (= ?l1 ?l2)
	     )
	     ; robot, box and content must be located at start 
	     (be_at_robot ?l1 ?r)
	     (be_at_box ?b ?l1)
	     (be_at_content ?c ?l1)
	     (assigned_carrier_box ?b ?cr)
	     (assigned_box_content ?b ?c)
	     (carrier_capacity_3 ?cr)
	 ) 
 	:subtasks (and (task0 (move_cc_3_wc ?b ?c ?cr ?l1 ?l2 ?r))) 
    ) 
    (:method m_get_to_move_cc_3_noc
 	:parameters (?b - box ?cr - carrier ?l1 - generic_location ?l2 - generic_location ?r - robot) 
 	:task (get_to ?l2 ?r) 
 	:precondition (and
	     ; check if not same locations
	     (not 
		 (= ?l1 ?l2)
	     )
	     ; robot, box and content must be located at start 
	     (be_at_robot ?l1 ?r )
	     (be_at_box ?b ?l1)
             ; check if box assigned to carrier
	     (assigned_carrier_box ?b ?cr )
             ; check carrier capacity
	     (carrier_capacity_3 ?cr)
	     (empty_box ?b)
	     
	 ) 
 	:subtasks (and (task0 ( move_cc_3_noc ?b ?cr ?l1 ?l2 ?r)) ) 
    ) 
    
